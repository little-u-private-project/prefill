{
  // Workers runtime types (generated by `wrangler types`) clash with lib DOM, hence a config of its own.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [],
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/worker.tsbuildinfo"
  },
  "include": ["worker", "src/lib/api.ts", "worker-configuration.d.ts"]
}
